{
  "name": "alif-school-monorepo",
  "version": "1.0.0",
  "description": "Alif Online Moral School - Complete Application",
  "private": true,
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../design-system && npm install",
    "backend:dev": "cd backend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "backend:start": "cd backend && npm start",
    "backend:test": "cd backend && npm test",
    "design-system:build": "cd design-system && npm run build",
    "lint": "cd backend && npm run lint",
    "test": "cd backend && npm test"
  },
  "workspaces": [
    "backend",
    "design-system"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "puppeteer": "^25.1.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
